[Unit]
Description=Dogsled host status service

[Service]
Type=simple
# The installer's path. `dogsled serve` updates this file and exits; systemd starts the
# new release. The service needs git, herdr, and the harness CLIs on PATH.
ExecStart=%h/.local/bin/dogsled serve
Restart=always
RestartSec=10
StateDirectory=dogsled
Environment=DOGSLED_STATE=%S/dogsled
StandardOutput=append:%S/dogsled/serve.stdout.log
StandardError=append:%S/dogsled/serve.stderr.log

[Install]
WantedBy=default.target
