<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Dotfiles replaces @HOME@ with the absolute home path and creates the log directory before loading. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.wrangle</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/.local/bin/mise</string>
    <string>x</string>
    <string>--</string>
    <string>wrangle</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>@HOME@</string>
    <key>WRANGLE_STATE</key>
    <string>@HOME@/.local/state/wrangle</string>
  </dict>
  <key>StandardOutPath</key>
  <string>@HOME@/.local/state/wrangle/serve.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/.local/state/wrangle/serve.stderr.log</string>
</dict>
</plist>
