{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/context.sh\" --harness claude --event SessionStart || true",
            "timeout": 6
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/context.sh\" --harness claude --event UserPromptSubmit || true",
            "timeout": 6
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/inbox.sh\" --harness claude --event UserPromptSubmit || true",
            "timeout": 6
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/inbox.sh\" --harness claude --event Stop || true",
            "timeout": 6
          }
        ]
      }
    ]
  }
}
