{
  "name": "wrangle",
  "version": "0.7.3",
  "description": "Host status, placement, jobs, and queue admission for Herdr agents.",
  "author": {
    "name": "oisin-ee",
    "url": "https://github.com/oisin-ee"
  },
  "repository": "https://github.com/oisin-ee/wrangle",
  "license": "MIT",
  "skills": "./skills/",
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "sh \"$PLUGIN_ROOT/hooks/context.sh\" --harness codex --event SessionStart || true",
              "timeout": 6
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "sh \"$PLUGIN_ROOT/hooks/context.sh\" --harness codex --event UserPromptSubmit || true",
              "timeout": 6
            }
          ]
        }
      ]
    }
  }
}
