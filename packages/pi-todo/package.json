{
  "name": "@oisin-ee/pi-todo",
  "version": "0.27.0",
  "description": "A todo tool for pi with a Rust core: one active task, state on the session branch.",
  "keywords": [
    "pi-extension",
    "pi-package",
    "todo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oisin-ee/dogsled.git",
    "directory": "packages/pi-todo"
  },
  "files": [
    "src/",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "typebox": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/oisin-ee/oisinpi/main/assets/prewalk.png"
  }
}
