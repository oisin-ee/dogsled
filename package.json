{
  "name": "@oisin-ee/pi-dogsled",
  "version": "0.13.0",
  "description": "Pi extension for dogsled: the board, the /dogsled panel, the inbox reader, and the dogsled tools. Needs the dogsled binary of the same version.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oisin-ee/dogsled.git"
  },
  "homepage": "https://github.com/oisin-ee/dogsled#readme",
  "files": [
    "pi/",
    "!pi/**/*.test.ts",
    "plugins/dogsled/skills/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "herdr",
    "agents",
    "orchestration"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"pi/**/*.test.ts\""
  },
  "pi": {
    "extensions": [
      "./pi/index.ts"
    ],
    "skills": [
      "./plugins/dogsled/skills/dogsled"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
