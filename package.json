{
  "name": "wrangle",
  "version": "0.9.0",
  "description": "Host status and placement for Herdr agents. CLI, Pi prompt context, and skill.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oisin-ee/wrangle.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "herdr",
    "agents",
    "orchestration"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"pi/**/*.test.ts\""
  },
  "pi": {
    "extensions": [
      "./pi/index.ts"
    ],
    "skills": [
      "./plugins/wrangle/skills/wrangle"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
