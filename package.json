{
  "name": "@oisin-ee/pi-dogsled",
  "version": "0.28.0",
  "description": "Pi extension for dogsled: the board, the /dogsled panel, the inbox reader, and the dogsled tools. Needs the dogsled binary of the same version.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oisin-ee/dogsled.git"
  },
  "homepage": "https://github.com/oisin-ee/dogsled#readme",
  "files": [
    "pi/",
    "!pi/**/*.test.ts",
    "!pi/todo/moon.yml",
    "!pi/todo/tsconfig.json",
    "!pi/todo/node_modules/",
    "plugins/dogsled/skills/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "herdr",
    "agents",
    "orchestration"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"pi/*.test.ts\""
  },
  "pi": {
    "extensions": [
      "./pi/index.ts"
    ],
    "skills": [
      "./plugins/dogsled/skills/dogsled"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "typebox": "*",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0"
  },
  "packageManager": "pnpm@12.9.1",
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "vitest": "catalog:",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "typebox": "catalog:"
  }
}
