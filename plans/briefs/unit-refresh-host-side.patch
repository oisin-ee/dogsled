+/// One host answer for a batch of refresh reads. Each entry is scoped to its own request.
+#[derive(Debug, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct ReceiptEntry {
+    pub request_id: String,
+    #[serde(default)]
+    pub evidence: Option<crate::unit_reply::HostEvidence>,
+    /// The host rejected this request's evidence.
+    #[serde(default)]
+    pub invalid: Option<String>,
+    /// The host could not read this request's evidence.
+    #[serde(default)]
+    pub failed: Option<String>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct ExecutionsInput {
+    pub executions: Vec<crate::unit_transport::ExecutionRef>,
+}
+
+/// Batch form of `unit_receipt`: one failing request never fails its neighbours.
+pub fn unit_receipts(
+    ledger: &Ledger,
+    executions: &[crate::unit_transport::ExecutionRef],
+) -> Vec<ReceiptEntry> {
+    executions
+        .iter()
+        .map(|execution| {
+            let mut entry = ReceiptEntry {
+                request_id: execution.request_id.clone(),
+                evidence: None,
+                invalid: None,
+                failed: None,
+            };
+            match unit_receipt(ledger, execution) {
+                Ok(evidence) => entry.evidence = evidence,
+                Err(Error::Invalid(message)) => entry.invalid = Some(message),
+                Err(error) => entry.failed = Some(error.to_string()),
+            }
+            entry
+        })
+        .collect()
+}
