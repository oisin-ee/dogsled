# Proto owns every dev tool of this repository (https://moonrepo.dev/docs/proto/config).
# Rust is pinned in rust-toolchain.toml, and rustup installs that toolchain.
# dx bundles the web portal. The plugin installs the Dioxus release binary; keep it equal to the dioxus crate in web/Cargo.toml.
dx = "0.7.10"
moon = "2.6.1"
node = "26.7.0"
pnpm = "12.9.1"
# The CLI version must equal the wasm-bindgen crate version.
wasm-bindgen = "0.2.129"
# pi-guardrails parses shell commands with shfmt --to-json.
shfmt = "3.14.1"

[plugins.tools]
dx = "file://.config/proto/plugins/dx.toml"
wasm-bindgen = "file://.config/proto/plugins/wasm-bindgen.toml"
shfmt = "file://.config/proto/plugins/shfmt.toml"
